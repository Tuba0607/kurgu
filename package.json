{
  "name": "kilit-content-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@prisma/client": "~6.19.3",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^3.21.11",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "prisma": "~6.19.3",
    "tailwindcss": "~3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}

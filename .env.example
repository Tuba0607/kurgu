# Copy this file to .env and adjust the values.
# .env is ignored by Git and must never be committed.

# ---------------------------------------------------------------------------
# Local development: PostgreSQL 16 in Docker (see docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=kilit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kilit_content_panel

# Runtime connection used by the app (Prisma Client).
DATABASE_URL="postgresql://kilit:change_me@localhost:5435/kilit_content_panel?schema=public"
# Direct connection used by Prisma Migrate. Locally identical to DATABASE_URL.
DIRECT_URL="postgresql://kilit:change_me@localhost:5435/kilit_content_panel?schema=public"

# ---------------------------------------------------------------------------
# Production: Neon PostgreSQL (configure in Vercel project environment variables)
# ---------------------------------------------------------------------------
# DATABASE_URL -> Neon *pooled* connection string (host contains "-pooler"),
#                 e.g. postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
# DIRECT_URL   -> Neon *direct* connection string (same host without "-pooler"),
#                 e.g. postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
# Never put real Neon credentials in this file.

# ---------------------------------------------------------------------------
# Demo deployment (Vercel)
# ---------------------------------------------------------------------------
# Allows `npm run db:seed` on a remote database and the nightly demo reset.
# Leave unset on any deployment that holds real data.
# ALLOW_DEMO_SEED=1
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (min. 16 characters),
# e.g. generate with: openssl rand -hex 32
# CRON_SECRET=
